import React, { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getAuth, 
  signInAnonymously, 
  signInWithCustomToken, 
  onAuthStateChanged 
} from 'firebase/auth';
import { 
  getFirestore, 
  collection, 
  doc, 
  setDoc, 
  onSnapshot, 
  query 
} from 'firebase/firestore';
import { 
  Users, User, GraduationCap, ClipboardList, CheckCircle2, 
  XCircle, BarChart3, ShieldCheck, LogIn, Trophy, Calculator, RotateCcw, Sparkles, BrainCircuit, MessageSquareText
} from 'lucide-react';

// --- CONFIGURAZIONE FIREBASE & API ---
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'math-rpg-default';
const apiKey = ""; // API Key fornita dall'ambiente

const PROF_KEY = "PROF2024";

const QUESTIONS = [
  { q: "lim(x→0) sin(x)/x", a: ["0", "1", "∞", "Non esiste"], c: 1, topic: "Limiti notevoli" },
  { q: "Derivata di x³", a: ["3x", "3x²", "x²", "2x³"], c: 1, topic: "Derivate fondamentali" },
  { q: "f(x)=|x| in x=0 è:", a: ["Derivabile", "Continua ma non derivabile", "Discontinua", "Un asintoto"], c: 1, topic: "Continuità e derivabilità" },
  { q: "lim(x→∞) 1/x", a: ["∞", "1", "0", "-1"], c: 2, topic: "Limiti all'infinito" },
  { q: "Derivata di ln(x)", a: ["eˣ", "x", "1/x", "1"], c: 2, topic: "Derivate di funzioni logaritmiche" },
  { q: "Asintoto di 1/(x-2)", a: ["x=0", "y=2", "x=2", "y=0"], c: 2, topic: "Studio degli asintoti" },
  { q: "f''(x) > 0 indica:", a: ["Crescenza", "Decrescenza", "Concavità verso l'alto", "Flesso"], c: 2, topic: "Studio della derivata seconda" },
  { q: "Derivata di sin(x)", a: ["cos(x)", "-cos(x)", "sin(x)", "tan(x)"], c: 0, topic: "Derivate goniometriche" },
  { q: "Teorema di Weierstrass richiede:", a: ["Derivabilità", "Dominio R", "Continuità su [a,b]", "Asintoti"], c: 2, topic: "Teoremi sulle funzioni continue" },
  { q: "lim(x→0) (eˣ-1)/x", a: ["0", "e", "1", "∞"], c: 2, topic: "Limiti esponenziali" }
];

export default function App() {
  const [user, setUser] = useState(null);
  const [role, setRole] = useState(null); // 'student' o 'professor'
  const [userName, setUserName] = useState("");
  const [allResults, setAllResults] = useState([]);
  const [currentStep, setCurrentStep] = useState('login'); // 'login', 'quiz', 'result', 'dashboard'
  const [quizState, setQuizState] = useState({ index: 0, score: 0, answers: [] });
  const [inputKey, setInputKey] = useState("");
  
  // Stati per Gemini API
  const [explanation, setExplanation] = useState(null);
  const [isExplaining, setIsExplaining] = useState(false);
  const [classReport, setClassReport] = useState(null);
  const [isGeneratingReport, setIsGeneratingReport] = useState(false);

  // Inizializzazione Auth
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error("Auth error:", error);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // Listener Firestore per i risultati
  useEffect(() => {
    if (!user) return;
    const resultsRef = collection(db, 'artifacts', appId, 'public', 'data', 'results');
    const q = query(resultsRef);
    const unsub = onSnapshot(q, (snapshot) => {
      const docs = snapshot.docs.map(d => ({ id: d.id, ...d.data() }));
      setAllResults(docs);
    }, (err) => console.error("Firestore Error:", err));
    return () => unsub();
  }, [user]);

  const startAsStudent = () => {
    if (userName.trim()) {
      setRole('student');
      setCurrentStep('quiz');
    }
  };

  const verifyProf = () => {
    if (inputKey === PROF_KEY) {
      setRole('professor');
      setCurrentStep('dashboard');
    } else {
      setInputKey("");
      alert("Password errata!");
    }
  };

  async function callGemini(prompt, systemInstruction = "") {
    let retries = 0;
    const delays = [1000, 2000, 4000, 8000, 16000];
    while (retries < 5) {
      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }],
            systemInstruction: systemInstruction ? { parts: [{ text: systemInstruction }] } : undefined
          })
        });
        if (!response.ok) throw new Error('API Error');
        const data = await response.json();
        return data.candidates?.[0]?.content?.parts?.[0]?.text;
      } catch (err) {
        retries++;
        if (retries === 5) throw err;
        await new Promise(res => setTimeout(res, delays[retries-1]));
      }
    }
  }

  const getAiExplanation = async (question, wrongAnswer, correctAnswer) => {
    setIsExplaining(true);
    setExplanation(null);
    try {
      const prompt = `Spiega brevemente perché la risposta "${wrongAnswer}" è errata per il quesito "${question}" e perché la risposta corretta è "${correctAnswer}".`;
      const systemPrompt = "Sei un professore di matematica amichevole che aiuta gli studenti a capire i propri errori.";
      const result = await callGemini(prompt, systemPrompt);
      setExplanation(result);
    } catch (err) {
      setExplanation("Il professore virtuale è occupato al momento.");
    } finally {
      setIsExplaining(false);
    }
  };

  const generateClassReport = async () => {
    if (allResults.length === 0) return;
    setIsGeneratingReport(true);
    try {
      const statsSummary = allResults.map(r => `${r.name}: ${r.grade}/10`).join(", ");
      const prompt = `Risultati classe: ${statsSummary}. Analizza e fornisci un breve rapporto strategico per il docente.`;
      const systemPrompt = "Sei un assistente didattico IA che analizza dati scolastici.";
      const result = await callGemini(prompt, systemPrompt);
      setClassReport(result);
    } catch (err) {
      setClassReport("Errore nella generazione del rapporto.");
    } finally {
      setIsGeneratingReport(false);
    }
  };

  const handleAnswer = async (idx) => {
    if (!user) return;
    const currentQ = QUESTIONS[quizState.index];
    const correct = idx === currentQ.c;
    const newAnswers = [...quizState.answers, { 
      q: currentQ.q, 
      correct, 
      given: currentQ.a[idx], 
      correctText: currentQ.a[currentQ.c] 
    }];
    const newScore = correct ? quizState.score + 1 : quizState.score;

    if (quizState.index < QUESTIONS.length - 1) {
      setQuizState({ ...quizState, index: quizState.index + 1, score: newScore, answers: newAnswers });
    } else {
      const finalGrade = (newScore / QUESTIONS.length) * 10;
      await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'results', user.uid), {
        name: userName,
        score: newScore,
        grade: finalGrade.toFixed(1),
        answers: newAnswers,
        timestamp: Date.now(),
        uid: user.uid
      });
      setQuizState({ ...quizState, score: newScore, answers: newAnswers });
      setCurrentStep('result');
    }
  };

  // VISTA LOGIN
  if (currentStep === 'login') {
    return (
      <div className="min-h-screen bg-slate-900 flex items-center justify-center p-4 font-sans">
        <div className="max-w-md w-full bg-white rounded-3xl shadow-2xl p-8">
          <div className="text-center mb-8">
            <div className="bg-blue-600 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <GraduationCap className="text-white w-10 h-10" />
            </div>
            <h1 className="text-2xl font-black uppercase text-slate-800">Liceo Scientifico RPG</h1>
          </div>

          {role !== 'professor-auth' ? (
            <div className="space-y-6">
              <div>
                <label className="block text-[10px] font-black text-slate-400 uppercase mb-2">Nome Studente</label>
                <input 
                  type="text" 
                  className="w-full px-4 py-3 bg-slate-50 border-2 border-slate-100 rounded-xl focus:border-blue-500 outline-none font-bold"
                  placeholder="Inserisci nome..."
                  value={userName}
                  onChange={(e) => setUserName(e.target.value)}
                />
              </div>
              <button onClick={startAsStudent} className="w-full bg-blue-600 text-white font-black py-4 rounded-xl shadow-xl">ENTRA COME STUDENTE</button>
              <button onClick={() => setRole('professor-auth')} className="w-full text-slate-400 font-bold text-xs uppercase flex items-center justify-center gap-2 mt-4">
                <ShieldCheck className="w-4 h-4" /> Area Docente
              </button>
            </div>
          ) : (
            <div className="space-y-4">
              <h3 className="font-black text-slate-800 uppercase text-center">Inserisci Chiave Registro</h3>
              <input 
                type="password" 
                className="w-full p-4 border-2 border-slate-100 rounded-xl outline-none focus:border-blue-600 text-center font-bold"
                placeholder="Password..."
                value={inputKey}
                onChange={(e) => setInputKey(e.target.value)}
                autoFocus
              />
              <div className="flex gap-2">
                <button onClick={() => setRole(null)} className="flex-1 py-3 text-slate-400 font-bold uppercase text-xs">Annulla</button>
                <button onClick={verifyProf} className="flex-1 py-3 bg-blue-600 text-white rounded-xl font-bold uppercase text-xs">Accedi</button>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  }

  // VISTA DASHBOARD DOCENTE
  if (currentStep === 'dashboard') {
    return (
      <div className="min-h-screen bg-slate-50 p-6">
        <div className="max-w-6xl mx-auto">
          <header className="flex justify-between items-center mb-10">
            <div className="flex items-center gap-4">
              <div className="p-4 bg-slate-900 rounded-2xl text-white"><Users /></div>
              <h1 className="text-3xl font-black text-slate-900 uppercase">Cattedra Digitale</h1>
            </div>
            <div className="flex gap-2">
              <button onClick={generateClassReport} className="bg-indigo-600 text-white px-6 py-3 rounded-xl flex items-center gap-2 font-bold text-xs uppercase">
                {isGeneratingReport ? "Generazione..." : "✨ Rapporto IA"}
              </button>
              <button onClick={() => window.location.reload()} className="bg-white p-3 border rounded-xl"><RotateCcw className="w-5 h-5 text-slate-400" /></button>
            </div>
          </header>

          {classReport && (
            <div className="mb-8 bg-indigo-50 border-2 border-indigo-100 p-6 rounded-3xl text-indigo-900 italic relative">
              <button onClick={() => setClassReport(null)} className="absolute top-4 right-4 text-xs font-bold uppercase text-indigo-300">X</button>
              <div className="flex items-center gap-2 mb-2"><BrainCircuit className="w-5 h-5" /> <strong>Analisi IA:</strong></div>
              <p>"{classReport}"</p>
            </div>
          )}

          <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div className="lg:col-span-2 space-y-4">
              <h2 className="font-black text-slate-400 text-xs uppercase tracking-widest mb-4">Elaborati Ricevuti</h2>
              {allResults.map((res) => (
                <div key={res.id} className="bg-white p-6 rounded-2xl shadow-sm flex items-center justify-between border border-slate-100">
                  <div className="flex items-center gap-4">
                    <div className="w-12 h-12 bg-slate-900 rounded-xl flex items-center justify-center text-white font-black">{res.name?.[0]}</div>
                    <div className="font-black text-slate-800">{res.name}</div>
                  </div>
                  <div className={`px-4 py-2 rounded-xl font-black ${parseFloat(res.grade) >= 6 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                    {res.grade}/10
                  </div>
                </div>
              ))}
            </div>
            <div className="bg-white p-8 rounded-3xl shadow-xl h-fit border border-slate-100">
               <h2 className="font-black text-slate-400 text-xs uppercase tracking-widest mb-6">Statistiche</h2>
               <div className="text-5xl font-black text-blue-600 mb-2">
                 {allResults.length > 0 ? (allResults.reduce((acc, curr) => acc + parseFloat(curr.grade), 0) / allResults.length).toFixed(1) : "0.0"}
               </div>
               <div className="text-xs font-bold text-slate-300 uppercase tracking-widest">Media Voti</div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // VISTA QUIZ STUDENTE
  if (currentStep === 'quiz') {
    const q = QUESTIONS[quizState.index];
    return (
      <div className="min-h-screen bg-slate-900 flex flex-col items-center justify-center p-4">
        <div className="max-w-2xl w-full bg-white rounded-[2.5rem] shadow-2xl p-10">
          <div className="flex justify-between items-center mb-8">
            <span className="font-black text-slate-400 uppercase text-xs">Domanda {quizState.index + 1}/{QUESTIONS.length}</span>
            <span className="bg-slate-900 text-white px-3 py-1 rounded-lg text-xs font-bold">{userName}</span>
          </div>
          <h2 className="text-3xl font-black text-slate-900 mb-8 p-6 bg-slate-50 rounded-2xl border-l-8 border-blue-600">{q.q}</h2>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {q.a.map((opt, i) => (
              <button key={i} onClick={() => handleAnswer(i)} className="p-6 text-left border-2 border-slate-100 rounded-2xl hover:border-blue-600 font-bold transition-all text-slate-700 active:scale-95">
                {opt}
              </button>
            ))}
          </div>
        </div>
      </div>
    );
  }

  // VISTA RISULTATO STUDENTE
  if (currentStep === 'result') {
    const grade = (quizState.score / QUESTIONS.length) * 10;
    return (
      <div className="min-h-screen bg-slate-900 flex items-center justify-center p-4">
        <div className="max-w-xl w-full bg-white rounded-[3rem] p-12 text-center text-slate-900">
          <div className="bg-green-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6"><CheckCircle2 className="text-green-500 w-10 h-10" /></div>
          <h2 className="text-3xl font-black uppercase mb-2">Test Completato!</h2>
          <div className="text-7xl font-black text-blue-600 mb-8">{grade.toFixed(1)}/10</div>
          
          <div className="bg-blue-50 p-6 rounded-2xl text-left border border-blue-100 mb-6">
            <h4 className="flex items-center gap-2 font-black text-blue-800 uppercase text-xs mb-3"><Sparkles className="w-4 h-4" /> Spiegazione IA</h4>
            {explanation ? (
              <p className="text-sm italic text-blue-900 leading-relaxed">"{explanation}"</p>
            ) : (
              <button 
                onClick={() => {
                  const firstWrong = quizState.answers.find(a => !a.correct);
                  if (firstWrong) getAiExplanation(firstWrong.q, firstWrong.given, firstWrong.correctText);
                }}
                disabled={isExplaining || grade === 10}
                className="w-full bg-blue-600 text-white py-3 rounded-xl font-bold text-xs uppercase"
              >
                {isExplaining ? "Analizzando..." : "Spiega il mio errore"}
              </button>
            )}
          </div>
          <button onClick={() => window.location.reload()} className="text-slate-400 font-bold uppercase text-xs hover:text-slate-800">Torna all'inizio</button>
        </div>
      </div>
    );
  }

  return null;
}
